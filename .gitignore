# Only reviewed progress documents are included by default.
*
!/.gitignore
!/README.md
!/progress.json
!/PROGRESS.md
!/MAPPING.md
!/ANALYSIS.md
!/analysis/
!/analysis/function-review.json
!/analysis/status.json
!/analysis/system-map.json
!/analysis/research-details.json
!/assets/
!/assets/status.svg
!/assets/status-badges.svg
!/scripts/
!/scripts/generate_status.py

# Defense in depth: keep analysis inputs, projects, dumps, and secrets out.
inputs/
project/
decompiled/
reports/
cache/
logs/
backups/
snapshots/
*.gzf
*.gpr
*.rep/
*.gdt
*.bin
*.exe
*.dll
*.elf
*.self
*.sprx
*.prx
*.pkg
*.zip
*.7z
*.rar
*.tar
*.gz
*.dump
*.dmp
*.log
*.c
*.h
*.cpp
*.asm
*.s
.env
.env.*
*.pem
*.key
*.pfx
*.p12
*secret*
*credential*
*token*
auth.json
config.toml
.codex/
.ssh/
.git-credentials
__pycache__/
venv/
.venv/

!analysis/time-bounds-signature-correction.json

!/analysis/timeline-interval-signature-correction.json
